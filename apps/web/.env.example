# Accounts
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Network selection (REQUIRED) — '55516' (Geo testnet) or '80451' (mainnet).
# There is no default: an unset value fails the build rather than guessing a
# network. The mainnet cutover flips this var; no code change involved.
NEXT_PUBLIC_CHAIN_ID=55516

# Contract address overrides (optional on testnet, REQUIRED on any other chain).
# When unset on testnet, the geo-sdk's built-in testnet addresses apply. Set these
# for a contract cutover the SDK doesn't ship yet, or for mainnet (the SDK has no
# mainnet addresses).
# NEXT_PUBLIC_SPACE_REGISTRY_ADDRESS=
# NEXT_PUBLIC_DAO_SPACE_FACTORY_ADDRESS=

# Gas-sponsorship RPC override (optional). When unset on testnet, the geo-sdk's
# built-in sponsorship endpoint applies. Use this to route around a ZeroDev-side
# proxy bug on their `?selfFunded=true` handler — explicitly requesting the
# ULTRA_RELAY provider avoids it:
# NEXT_PUBLIC_SPONSORSHIP_RPC_URL=https://rpc.zerodev.app/api/v3/d26c96b9-7ee9-4d78-b139-954470b696e5/chain/55516?provider=ULTRA_RELAY

# Blockchain RPC (Mainnet) — required only when NEXT_PUBLIC_CHAIN_ID=80451.
# The geo-sdk has no mainnet config, so there is no fallback.
# NEXT_PUBLIC_GEOGENESIS_RPC=
# NEXT_PUBLIC_API_ENDPOINT=

# Blockchain RPC (Testnet) — OPTIONAL overrides; when unset, the geo-sdk's
# built-in testnet RPC and API origin apply.
# NEXT_PUBLIC_GEOGENESIS_RPC_TESTNET=
# NEXT_PUBLIC_API_ENDPOINT_TESTNET=

# Onboarding
NEXT_PUBLIC_ONBOARD_FLAG=
NEXT_PUBLIC_ONBOARD_CODE=

# Community calls (server-only)
# Required. Every /api/community-call/* route proxies to curator-backend, which also
# owns calls, recordings, and RSVPs. There's deliberately no fallback — an unset value
# throws rather than silently drifting. Point local dev at the same shared deploy prod
# uses, so data created in one environment is visible in the others.
CURATOR_BACKEND_URL=https://curator-api-staging-testnet.up.railway.app
# Optional. Transcripts come from rapporteur, a separate service; defaults to the shared
# staging deploy. Only set this to test against a different one.
# RAPPORTEUR_BACKEND_URL=

# Newsletter — MailerLite (server-only, REQUIRED for the Explore email capture)
# The API key for the MailerLite account that owns the subscriber list. Read only by
# /api/newsletter/subscribe and never sent to the browser — deliberately NOT a
# NEXT_PUBLIC_ variable, since anything with that prefix is inlined into the bundle and
# readable by every visitor, and the form it serves runs for anonymous readers on a public
# page. Unset, the endpoint logs and answers "failed" rather than throwing, so a missing key
# costs the signup rather than the page.
#
# This key alone is enough to exercise the form locally: with no Redis reachable the route skips
# rate limiting in development and says so in the server log. In production the same failure is
# refused instead -- a deploy that cannot rate limit must not quietly become an unlimited public
# relay into someone else's mailing list.
# MAILERLITE_API_KEY=

# Upstash Redis — shared by the rate limiters in app/api/chat, app/api/ranking-og and
# app/api/newsletter. Not newsletter-specific, and already configured on the deploys.
# `Redis.fromEnv()` accepts EITHER naming, so check for both before concluding it is unset:
# Vercel's own Upstash integration provisions the KV_ pair, which is easy to miss when searching
# for "upstash" or "redis".
# UPSTASH_REDIS_REST_URL=      (or KV_REST_API_URL)
# UPSTASH_REDIS_REST_TOKEN=    (or KV_REST_API_TOKEN)
#
# Exception, until GEO-2930 lands: app/api/ranking-og/rate-limit.ts checks for the UPSTASH_ pair
# by name before building its limiters, so on a deploy carrying only the KV_ pair its rate
# limiting silently does not engage. It fails open by design, so nothing surfaces. chat and
# newsletter call `Redis.fromEnv()` and are unaffected.

# Sentry (optional)
# NEXT_PUBLIC_APP_ENV=                    # Deployment environment (default: "development")
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ORG=                             # All 3 required together for source maps
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# Analytics (optional)
# NEXT_PUBLIC_AMPLITUDE_API_KEY=87bc6bb6653d7ba096c25a1330dd83a
# NEXT_PUBLIC_POSTHOG_TOKEN=
# NEXT_PUBLIC_POSTHOG_HOST=https://v.geobrowser.io

# X Ads pixel (optional)
# NEXT_PUBLIC_X_PIXEL_ID=

# Features (optional)
# Public Mapbox token, inlined into the bundle and used by mapbox-gl to render maps. A `pk.` token,
# restricted by URL in the Mapbox dashboard.
# NEXT_PUBLIC_MAPBOX_TOKEN=
# Server-only Mapbox token for /api/places/search and /api/places/coordinates. Separate from the
# public one above and never sent to the browser — those routes exist so it is not. Without it the
# place-search field returns 502s.
# MAPBOX_TOKEN=
# NEXT_PUBLIC_GEO_CHAT_API_BASE_URL=http://localhost:8080
# Public host for published debate media URLs (written on-chain). Defaults to
# NEXT_PUBLIC_GEO_CHAT_API_BASE_URL; in production one of the two must be set. Must be an absolute
# http(s) URL, so set it explicitly when using the /geo-chat-proxy dev setup.
# NEXT_PUBLIC_DEBATE_MEDIA_BASE_URL=http://localhost:8080
# Debate acceptor find-or-create (server only). A transcript claim geo-chat matched to an existing
# Claim in the debate's space is linked to that entity instead of minted again, after the publisher
# re-verifies it. On by default; set to false for shadow mode, where geo-chat's matching still runs
# and its verdicts can be read from geo-chat's GET /debates/{id}/claims but no entity is reused.
# DEBATE_CLAIM_REUSE_ENABLED=false

# Build (optional)
# DISABLE_REACT_COMPILER=1
# DISABLE_SENTRY=1

# Dev (optional)
# NEXT_PUBLIC_ENGINE_LOGGING=0            # Set to 0 to suppress
# NEXT_PUBLIC_STORE_LOGGING=0             # Set to 0 to suppress
